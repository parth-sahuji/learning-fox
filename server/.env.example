# ================================
# LEARNING FOX — Environment Config
# ================================

# Server
PORT=5001
NODE_ENV=production

# Client URL (update to your Vercel domain after deploying frontend)
CLIENT_URL=http://localhost:5173

# ── DATABASE (Supabase) ──────────────────────────────
# Get this from: Supabase → Project → Settings → Database → Connection string (URI)
# Click "Transaction" pooler mode for Railway compatibility
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────
# Generate a random 64-char string: https://generate-secret.vercel.app/64
# Required — the server refuses to start without this (no built-in fallback).
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-64-chars

# ── ADMIN ACCOUNTS ───────────────────────────────────
# These double as admin login identities (db.js seeds/auth.js checks against them).
# Set your real values only in Render's dashboard — never commit real values here.
# If unset, admin seeding is skipped (no hardcoded fallback).
ADMIN_EMAIL_1=admin1@example.com
ADMIN_EMAIL_2=admin2@example.com

# ── CLOUDINARY (portfolio uploads) ───────────────────
# Get these from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── SUPABASE STORAGE (Aadhar/resume docs) ────────────
# Get these from: Supabase → Project → Settings → API
# SUPABASE_SERVICE_ROLE_KEY is a secret — never expose it to the frontend.
# Bucket 'reg-docs' must exist and be PRIVATE.
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── EMAIL (Brevo transactional API) ──────────────────────────────────────────
# Get BREVO_API_KEY from: Brevo → SMTP & API → API Keys
# BREVO_SENDER_EMAIL must be a verified/domain-authenticated sender in Brevo
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=no-reply@learningfoxx.com
# Shown to users in every email footer + "contact us" spots on the site
SUPPORT_EMAIL=support@learningfoxx.com

# ── RATE LIMITING (per-IP, express-rate-limit) ───────
# Strict tier: login, register (+ /student /teacher), forgot/reset-password, upload-doc
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Moderate tier: public endpoints (health check)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
# Loose tier: logged-in actions (teacher/student/admin routes)
RATE_LIMIT_AUTHED_WINDOW_MS=60000
RATE_LIMIT_AUTHED_MAX=120

# ── LOGIN BACKOFF (per-account, on top of the IP limit above) ───────────────
# After this many wrong passwords for one account, each further attempt adds
# an exponentially growing delay (capped) instead of a hard lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_BASE_MS=30000
LOGIN_LOCKOUT_MAX_MS=900000
