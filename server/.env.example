# ================================
# LEARNING FOX — Environment Config
# ================================

# Server
PORT=5001
NODE_ENV=production

# Client URL (update to your Vercel domain after deploying frontend)
CLIENT_URL=http://localhost:5173

# ── DATABASE (Supabase) ──────────────────────────────
# Get this from: Supabase → Project → Settings → Database → Connection string (URI)
# Click "Transaction" pooler mode for Railway compatibility
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres

# ── JWT ─────────────────────────────────────────────
# Generate a random 64-char string: https://generate-secret.vercel.app/64
JWT_SECRET=replace-with-a-very-long-random-secret-at-least-64-chars

# ── ADMIN ACCOUNTS ───────────────────────────────────
ADMIN_EMAIL_1=Ksl.13021412@gmail.com
ADMIN_EMAIL_2=parthcollege1@gmail.com

# ── CLOUDINARY ───────────────────────────────────────
# Get these from: cloudinary.com → Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
